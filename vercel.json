{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py", "headers": {"Cache-Control": "no-store"} },
    { "src": "/assets/(.*)", "dest": "/frontend/dist/assets/$1", "headers": {"Cache-Control": "public, max-age=31536000, immutable"} },
    { "src": "/(.*)", "dest": "/frontend/dist/$1" }
  ]
}
